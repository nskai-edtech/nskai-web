# Contact form delivery (the Chapter Hub no longer sends email). Without both of these, /api/contact returns 503 and
# the page falls back to the mailto: link in the aside.
RESEND_API_KEY=
CONTACT_FROM_ADDRESS="NSK AI <website@nskai.org>"

# Chapter Hub (/hub). Signs and verifies the session cookie — required in
# production; without it the hub refuses to sign sessions at all.
SESSION_SECRET=

# Chapter Hub admin allowlist, comma separated. Required in production; without
# it no one can sign in as a Chapter Hub admin.
ADMIN_EMAILS=nsukka.ai@gmail.com,nskai.org@gmail.com

# The one password the admins above share. Required: without it no one can
# sign in as admin. Use a long random one and keep it out of chat and email.
ADMIN_PASSWORD=

# Chapter Hub invite-link accounts (lib/hub-kv.ts): Upstash Redis free tier.
# Without these, admins can still sign in, but officer invite links and
# self-service accounts are disabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: a published Google Sheet CSV URL that chapter directory data is
# synced from (lib/hub-data.ts getChapters). Without it, the hub falls back to
# the hardcoded SEED_CHAPTERS roster.
GOOGLE_SHEET_CSV_URL=

# Site assistant ("Ask NSK AI", /api/assistant). An xAI (Grok) API key and the
# Grok model id to call. Both are required; without them the widget still
# opens and tells the visitor the assistant is not connected yet.
XAI_API_KEY=
ASSISTANT_MODEL=

# Optional: another OpenAI-compatible chat-completions endpoint to use instead
# of xAI's (XAI_API_KEY is then that provider's key).
ASSISTANT_API_URL=
